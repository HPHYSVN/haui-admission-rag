# ---------------------------------------------------------------------------
# LLM generation (primary names).
# Every supported provider speaks the OpenAI /chat/completions protocol.
#   LLM_PROVIDER: openai_compatible | vllm | ollama | openai
#   The name selects the default LLM_BASE_URL; it does not change the adapter.
# The legacy VLLM_* names below still work as aliases.
# See docs/llm-providers.md.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=JunHowie/Qwen3-4B-Instruct-2507-GPTQ-Int4
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
# Optional; omit to use the provider default.
# LLM_TOP_P=0.9
# Provider-specific body fields as a JSON object, e.g. {"repetition_penalty": 1.05}
# LLM_EXTRA_BODY={}

# Legacy aliases (still supported, used only when the LLM_* value is unset).
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=JunHowie/Qwen3-4B-Instruct-2507-GPTQ-Int4
# VLLM_API_KEY=

# Prompt profile: haui_admission (default) or generic.
RAG_PROMPT_PROFILE=haui_admission

# ---------------------------------------------------------------------------
# Retrieval and local indexes. These are independent of the generation model.
# ---------------------------------------------------------------------------
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# ONNX activation memory grows with this. 256 (fastembed default) can need ~8 GB
# for e5-large; 32 keeps the peak near 3 GB.
RAG_EMBED_BATCH_SIZE=32
RAG_ALPHA=0.5
RAG_SCORE_THRESHOLD=0.08
RAG_MIN_TERM_COVERAGE=0.3
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RAG_RERANKER_CANDIDATES=12
RAG_RERANKER_RETRIEVAL_WEIGHT=4.0
RAG_TOP_K=4
# RAG_CHUNKS_DIR=data/chunks/final
# RAG_INDEX_DIR=data/indexes/vector

# ---------------------------------------------------------------------------
# FastAPI / HTTP hardening.
# ---------------------------------------------------------------------------
APP_ALLOWED_ORIGINS=http://localhost:5173
APP_MAX_QUESTION_LENGTH=2000
APP_MAX_HISTORY_MESSAGES=8

# Request body limit enforced before JSON parsing (bytes). Default 64 KiB.
APP_MAX_REQUEST_BYTES=65536

# Opt-in in-process rate limit per client per minute for /api/v1/chat and
# /api/v1/chat/stream. 0 disables it. Multi-worker deployments should enforce
# this at the gateway.
APP_RATE_LIMIT_PER_MINUTE=0

# Opt-in API-key gate for /api/v1/chat and /api/v1/chat/stream. Leave empty to
# keep the endpoints open, which is the historical behaviour. Use a
# gateway/proxy for production auth.
APP_API_KEY=

# ---------------------------------------------------------------------------
# Docker Compose overrides (ignored when running directly).
# host.docker.internal is how the backend container reaches a vLLM/Ollama
# server running on the host.
# ---------------------------------------------------------------------------
# DOCKER_LLM_BASE_URL=http://host.docker.internal:8000/v1
# BACKEND_PORT=8001
# FRONTEND_PORT=8080
