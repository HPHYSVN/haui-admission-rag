# OpenAI-compatible vLLM server endpoint. Do not put real credentials here.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=JunHowie/Qwen3-4B-Instruct-2507-GPTQ-Int4
VLLM_API_KEY=

# Local multilingual sentence embeddings (downloaded on first use, not committed).
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_ALPHA=0.5
RAG_SCORE_THRESHOLD=0.08
RAG_MIN_TERM_COVERAGE=0.3
